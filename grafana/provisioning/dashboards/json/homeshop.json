{
  "title": "HomeShop Overview",
  "uid": "homeshop-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Orders placed (rate, per minute)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(orders_placed_total[5m])) * 60",
          "legendFormat": "orders placed / min"
        }
      ],
      "description": "Uses rate() rather than the raw counter because orders_placed_total only ever goes up; the rate shows how fast it's climbing right now."
    },
    {
      "id": 2,
      "title": "Order outcomes (completed vs failed vs cancelled)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(orders_completed_total[5m]) * 60", "legendFormat": "completed / min" },
        { "expr": "rate(orders_failed_total[5m]) * 60", "legendFormat": "failed / min" },
        { "expr": "rate(orders_cancelled_total[5m]) * 60", "legendFormat": "cancelled / min" }
      ]
    },
    {
      "id": 3,
      "title": "Orders currently in queue (pending + processing)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "orders_queue_depth", "legendFormat": "queue depth" }
      ],
      "description": "A Gauge, not a Counter - it goes up when orders arrive and down as the worker finishes them."
    },
    {
      "id": 4,
      "title": "Inventory stock by product",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "inventory_stock{job=\"homeshop-api\"}", "legendFormat": "{{seller_id}} — {{product_name}}" }
      ]
    },
    {
      "id": 5,
      "title": "Payment processing latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(payment_processing_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(payment_processing_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(payment_processing_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ],
      "description": "Computed from the Histogram's bucket data via histogram_quantile(). This is the metric we will deliberately degrade in the Part E anomaly experiment."
    },
    {
      "id": 6,
      "title": "HTTP request latency (p95 by route)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, path))", "legendFormat": "{{path}}" }
      ]
    },
    {
      "id": 7,
      "title": "Average order fulfillment time (Summary)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "rate(order_fulfillment_seconds_sum[5m]) / rate(order_fulfillment_seconds_count[5m])",
          "legendFormat": "avg fulfillment time (s)"
        }
      ],
      "description": "Manual sum/count average since Python Summaries don't expose percentiles."
    },
    {
      "id": 8,
      "title": "Revenue collected (running total, $)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "revenue_cents_total / 100" }
      ]
    },
    {
      "id": 9,
      "title": "Host CPU usage % (homeshop-dev-host)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\", instance=\"homeshop-dev-host\"}[5m])) * 100)",
          "legendFormat": "CPU %"
        }
      ]
    },
    {
      "id": 10,
      "title": "Host memory used % (homeshop-dev-host)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{instance=\"homeshop-dev-host\"} / node_memory_MemTotal_bytes{instance=\"homeshop-dev-host\"}))",
          "legendFormat": "Memory %"
        }
      ]
    },
    {
      "id": 11,
      "title": "Part E.2: High Cardinality Metric Series Count (count(cardinality_test_total))",
      "type": "stat",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "targets": [
        { "expr": "count(cardinality_test_total)", "legendFormat": "Time Series Count" }
      ],
      "description": "Demonstrates high cardinality time-series explosion when unique request IDs are added as metric labels."
    },
    {
      "id": 12,
      "title": "API requests per minute (by route, method, status)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "targets": [
        {
          "expr": "sum by (method, path, status) (rate(http_requests_total[5m])) * 60",
          "legendFormat": "{{method}} {{path}} ({{status}})"
        }
      ],
      "description": "Visualizes the HTTP request counter as a per-minute rate, split by method, route template, and response status."
    },
    {
      "id": 13,
      "title": "Checkout rejections per minute (by reason)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "targets": [
        {
          "expr": "sum by (reason) (rate(checkout_rejected_total[5m])) * 60",
          "legendFormat": "{{reason}}"
        }
      ],
      "description": "Shows rejected checkout attempts, grouped by reason such as empty_cart or out_of_stock."
    },
    {
      "id": 14,
      "title": "Payment failures per minute (by reason)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "targets": [
        {
          "expr": "sum by (reason) (rate(orders_failed_total[5m])) * 60",
          "legendFormat": "{{reason}}"
        }
      ],
      "description": "Breaks down failed order rates using the worker failure-reason label."
    },
    {
      "id": 15,
      "title": "Host available filesystem space (bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "targets": [
        {
          "expr": "sum by (mountpoint) (node_filesystem_avail_bytes{instance=\"homeshop-dev-host\", fstype!~\"tmpfs|overlay|squashfs\"})",
          "legendFormat": "{{mountpoint}}"
        }
      ],
      "description": "Shows available host filesystem space by mount point, excluding common pseudo and container filesystems."
    },
    {
      "id": 16,
      "title": "Host network traffic (bytes/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 64 },
      "targets": [
        {
          "expr": "sum by (device) (rate(node_network_receive_bytes_total{instance=\"homeshop-dev-host\", device!~\"lo\"}[5m]))",
          "legendFormat": "{{device}} received"
        },
        {
          "expr": "sum by (device) (rate(node_network_transmit_bytes_total{instance=\"homeshop-dev-host\", device!~\"lo\"}[5m]))",
          "legendFormat": "{{device}} transmitted"
        }
      ],
      "description": "Shows incoming and outgoing host network throughput by network interface."
    },
    {
      "id": 17,
      "title": "Checkout calls/sec by status — HTTP vs gRPC",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 72 },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{method=\"POST\", path=\"/checkout/{user_id}\"}[5m]))",
          "legendFormat": "HTTP {{status}}"
        },
        {
          "expr": "sum by (status) (rate(homeshop_grpc_rpc_calls_total{rpc_method=\"Checkout\"}[5m]))",
          "legendFormat": "gRPC {{status}}"
        }
      ],
      "description": "Compares HTTP checkout request rate with gRPC Checkout RPC rate, split by bounded protocol status. Rates use a 5-minute window."
    },
    {
      "id": 18,
      "title": "Checkout error rate — HTTP vs gRPC (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 72 },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{method=\"POST\", path=\"/checkout/{user_id}\", status=~\"4..|5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{method=\"POST\", path=\"/checkout/{user_id}\"}[5m])), 1e-9)",
          "legendFormat": "HTTP errors (%)"
        },
        {
          "expr": "100 * sum(rate(homeshop_grpc_rpc_calls_total{rpc_method=\"Checkout\", status!=\"OK\"}[5m])) / clamp_min(sum(rate(homeshop_grpc_rpc_calls_total{rpc_method=\"Checkout\"}[5m])), 1e-9)",
          "legendFormat": "gRPC errors (%)"
        }
      ],
      "description": "Error calls divided by all calls for each protocol, using the most recent 5-minute rate. HTTP 4xx/5xx and any non-OK gRPC status count as errors."
    },
    {
      "id": 19,
      "title": "Checkout server duration p50/p95 — HTTP vs gRPC (5m) [seconds]",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 80 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{method=\"POST\", path=\"/checkout/{user_id}\"}[5m])) by (le))",
          "legendFormat": "HTTP p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{method=\"POST\", path=\"/checkout/{user_id}\"}[5m])) by (le))",
          "legendFormat": "HTTP p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(homeshop_grpc_rpc_duration_seconds_bucket{rpc_method=\"Checkout\"}[5m])) by (le))",
          "legendFormat": "gRPC server p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(homeshop_grpc_rpc_duration_seconds_bucket{rpc_method=\"Checkout\"}[5m])) by (le))",
          "legendFormat": "gRPC server p95"
        }
      ],
      "description": "p50 and p95 are calculated from histogram buckets over a rolling 5-minute rate window. Both durations are measured server-side (HTTP middleware vs gRPC handler boundary)."
    },
    {
      "id": 20,
      "title": "gRPC checkout calls in flight",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 80 },
      "targets": [
        {
          "expr": "homeshop_grpc_rpc_in_flight{rpc_method=\"Checkout\"}",
          "legendFormat": "{{rpc_method}} in flight"
        }
      ],
      "description": "Current number of Checkout handlers running in the gRPC process. This Gauge was chosen over message-size instrumentation because it can reveal concurrent load and stuck calls directly."
    }
  ]
}

