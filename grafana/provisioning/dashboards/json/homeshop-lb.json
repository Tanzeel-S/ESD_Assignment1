{
  "title": "HomeShop Load Balancing (A3)",
  "uid": "homeshop-lb",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "assignment3"
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "HTTP \u2014 GET /products/{product_id}",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "HTTP request rate per replica (req/s, 1m)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus"
      },
      "description": "Calls per second handled by each replica, scraped directly from A, B and C (not through Envoy). 1-minute rate window.",
      "targets": [
        {
          "expr": "sum by (replica) (rate(http_requests_total{job=\"homeshop-app\", method=\"GET\", path=\"/products/{product_id}\"}[1m]))",
          "legendFormat": "{{replica}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP share of total traffic per replica (%, 1m)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus"
      },
      "description": "Each replica's percentage of all calls for this operation. Round robin target: 33.3% each; weighted 2:1:1 target: 50/25/25.",
      "targets": [
        {
          "expr": "100 * sum by (replica) (rate(http_requests_total{job=\"homeshop-app\", method=\"GET\", path=\"/products/{product_id}\"}[1m])) / scalar(sum(rate(http_requests_total{job=\"homeshop-app\", method=\"GET\", path=\"/products/{product_id}\"}[1m])))",
          "legendFormat": "{{replica}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP active requests per replica (max in 15s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus"
      },
      "description": "In-flight requests on each replica. The Gauge is sampled every 5 s scrape, so max_over_time over 15 s is shown to catch short peaks.",
      "targets": [
        {
          "expr": "max by (replica) (max_over_time(http_requests_in_flight{job=\"homeshop-app\"}[15s]))",
          "legendFormat": "{{replica}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "HTTP p50 / p95 server duration per replica (1m window)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus"
      },
      "description": "Server-side duration measured inside each replica, histogram_quantile over a 1-minute rate window.",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, replica) (rate(http_request_duration_seconds_bucket{job=\"homeshop-app\", method=\"GET\", path=\"/products/{product_id}\"}[1m])))",
          "legendFormat": "{{replica}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, replica) (rate(http_request_duration_seconds_bucket{job=\"homeshop-app\", method=\"GET\", path=\"/products/{product_id}\"}[1m])))",
          "legendFormat": "{{replica}} p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
